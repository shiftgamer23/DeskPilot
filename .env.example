# LLM provider (see app/config.py) - "groq" (free, primary) or "gemini" (fallback, stricter quota)
LLM_PROVIDER=groq
GROQ_API_KEY=
GEMINI_API_KEY=

# Redis cache (Phase 6) - local Docker in dev, Upstash in production. Unset/unreachable = caching
# silently disabled, agent still works (see app/infra/cache.py).
REDIS_URL=redis://localhost:6379/0

# Langfuse tracing (Phase 6) - unset = tracing silently disabled (see app/infra/tracing.py)
LANGFUSE_SECRET_KEY=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_BASE_URL=

# Ticket history persistence - unset = in-memory only, history lost on restart (see app/infra/db.py).
# A Postgres connection string, e.g. from Neon or Supabase.
DATABASE_URL=

# Voice mode (Sarvam AI, English) - unset = /voice/* endpoints return 503 (see app/infra/voice.py)
SARVAM_API_KEY=

# Deploy-time only (see scripts/fetch_index_data.py) - never needed for local dev.
INDEX_DATA_URL=
